# Local Apache only (not part of the build).
# Serves the built site from dist/ at http://localhost/for-fun/hell/ (build it with `npm run build:local`).
# Needs mod_rewrite and `AllowOverride FileInfo` (or All) for this folder, like ../zodiac/.htaccess.
# Caching: hashed bundles in assets/ never change, so they can be cached for a year;
# everything else (index.html, sw.js, manifest, icons) is re-checked on every load (a 304 answer is cheap).
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /for-fun/hell/
  # / -> the built page (floors are #rim, #gate-1 ..., so no other routes)
  RewriteRule ^$ dist/index.html [L]
  # a file of the build: assets/ ...
  RewriteCond %{DOCUMENT_ROOT}/for-fun/hell/dist/$1 -f
  RewriteRule ^(.+)$ dist/$1 [L]
</IfModule>
